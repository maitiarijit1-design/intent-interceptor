# All optional: the app works with zero keys (free path: DuckDuckGo web, Stack Overflow, dev.to, Reddit, GitHub, HN,
# competitor sitemap crawl, local BM25 relevance, extractive gap copy). XAI_API_KEY only adds Grok topics/copy.
# Brave Search API (free tier) = primary web source + competitor discovery; DuckDuckGo is the fallback.
BRAVE_API_KEY=
BRAVE_MAX_QUERIES_PER_SCAN=40
BRAVE_MONTHLY_CAP=2000
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
GITHUB_TOKEN=
X_BEARER_TOKEN=
PORT=8787
# Optional tuning
MAX_POSTS=15
SCANS_PER_15MIN=6
MAX_CONCURRENT_SCANS=4
# Only for sandboxes whose DNS returns 198.18.0.0/15 "fake IPs" via an egress proxy. Leave unset in production.
# SSRF_ALLOW_FAKE_IP=1
X_MAX_POSTS_PER_SCAN=200

# SEO & keyword tracker (free; no paid APIs, no Google SERP scraping)
# Number of top site keywords to rank-track per scan (default 10, max 20).
# Uses Brave top-20 when BRAVE_API_KEY is set (shares Brave throttle/caps), else DuckDuckGo (best effort).
SEO_RANK_KEYWORDS=10
